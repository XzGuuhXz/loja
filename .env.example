# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Public site URL used for metadata and payment callbacks.
NEXT_PUBLIC_SITE_URL=https://loja-nine-gold.vercel.app

# Security notes:
# - Never commit a real .env file.
# - Never expose service-role/database/Mercado Pago secrets to Client Components.
# - Configure production secrets in Vercel Environment Variables.
